{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["src/**/*.ts", "test/**/*.ts"],
  "ignoreDependencies": ["eslint-config-biome"],
  "rules": {
    "files": "error",
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off"
  }
}
