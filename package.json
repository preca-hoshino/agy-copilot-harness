{
  "name": "agy-copilot-harness",
  "displayName": "Antigravity Copilot Harness",
  "description": "Integrate Google Antigravity (agy acp) natively into VS Code Agents / Chat Sessions with account, quota, model, terminal, diff, and browser control support.",
  "version": "0.1.0",
  "publisher": "antigravity",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/preca-hoshino/agy-copilot-harness.git"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "agentsWindow": {
      "supported": true
    }
  },
  "main": "./dist/extension.js",
  "enabledApiProposals": [
    "chatSessionsProvider",
    "chatSessionCustomizationProvider",
    "chatParticipantAdditions",
    "chatProvider",
    "languageModelCapabilities",
    "languageModelThinkingPart",
    "chatStatusItem",
    "agentSessionsWorkspace"
  ],
  "contributes": {
    "authentication": [
      {
        "id": "google-antigravity",
        "label": "Google"
      }
    ],
    "chatSessions": [
      {
        "type": "antigravity",
        "name": "antigravity",
        "displayName": "Antigravity",
        "icon": "$(antigravity-logo)",
        "welcomeTitle": "Google Antigravity",
        "welcomeMessage": "Run agentic coding tasks with Google Antigravity (ACP)",
        "inputPlaceholder": "Ask Antigravity or type # to attach files...",
        "order": 3,
        "canDelegate": true,
        "description": "Google Antigravity coding agent via local ACP backend",
        "requiresCustomModels": true,
        "autoAttachReferences": true,
        "useRequestToPopulateBuiltInPickers": true,
        "capabilities": {
          "supportsFileAttachments": true,
          "supportsProblemAttachments": true,
          "supportsToolAttachments": false,
          "supportsImageAttachments": true,
          "supportsSymbolAttachments": true,
          "supportsSearchResultAttachments": true,
          "supportsSourceControlAttachments": true,
          "supportsPromptAttachments": true,
          "supportsHandOffs": true
        },
        "commands": [
          {
            "name": "plan",
            "description": "Switch Antigravity session to Plan mode for this prompt"
          },
          {
            "name": "compact",
            "description": "Compact and summarize the current Antigravity conversation context"
          }
        ]
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "antigravity",
        "displayName": "Antigravity",
        "icon": "$(antigravity-logo)"
      }
    ],
    "commands": [
      {
        "command": "antigravityHarness.showQuotaPicker",
        "title": "Show Account & Model Quotas",
        "category": "Antigravity",
        "icon": "$(pulse)"
      },
      {
        "command": "antigravityHarness.signIn",
        "title": "Sign In with Google",
        "category": "Antigravity",
        "icon": "$(sign-in)"
      },
      {
        "command": "antigravityHarness.signOut",
        "title": "Sign Out",
        "category": "Antigravity",
        "icon": "$(sign-out)"
      },
      {
        "command": "antigravityHarness.openSettings",
        "title": "Open Harness Settings",
        "category": "Antigravity",
        "icon": "$(gear)"
      },
      {
        "command": "antigravityHarness.manageModels",
        "title": "Manage Language Models",
        "category": "Antigravity",
        "icon": "$(antigravity-logo)"
      },
      {
        "command": "antigravityHarness.restartBackend",
        "title": "Restart ACP Backend",
        "category": "Antigravity",
        "icon": "$(debug-restart)"
      },
      {
        "command": "antigravityHarness.refreshSessions",
        "title": "Refresh Sessions",
        "category": "Antigravity",
        "icon": "$(refresh)"
      },
      {
        "command": "antigravityHarness.openMediaPreview",
        "title": "Open Browser Recording / Media",
        "category": "Antigravity",
        "icon": "$(device-camera-video)"
      },
      {
        "command": "antigravityHarness.patchArgvAndReload",
        "title": "Enable Proposed API & Reload",
        "category": "Antigravity"
      }
    ],
    "configuration": {
      "title": "Antigravity Harness",
      "properties": {
        "antigravityHarness.cliPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to agy / agy.exe binary. Leave empty for automatic discovery."
        },
        "antigravityHarness.appDataDir": {
          "type": "string",
          "default": "antigravity",
          "description": "Antigravity app data directory name under ~/.gemini (use 'antigravity' to share desktop/IDE login and sessions)."
        },
        "antigravityHarness.mainAgent": {
          "type": "string",
          "default": "",
          "description": "Antigravity main agent name for the ACP backend. Leave empty for the default agent. Reload VS Code after changing this setting."
        },
        "antigravityHarness.defaultMode": {
          "type": "string",
          "enum": [
            "default",
            "accept-edits",
            "auto",
            "plan"
          ],
          "default": "default",
          "description": "Default permission/execution mode for new Antigravity sessions."
        },
        "antigravityHarness.quotaRefreshIntervalSec": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "description": "Background quota polling interval in seconds."
        },
        "antigravityHarness.mirrorTerminals": {
          "type": "boolean",
          "default": false,
          "description": "Mirror ACP backend terminal executions into VS Code integrated terminal tabs."
        },
        "antigravityHarness.showStatusBarQuota": {
          "type": "boolean",
          "default": true,
          "description": "Show Antigravity quota indicator in the VS Code status bar."
        }
      }
    },
    "icons": {
      "antigravity-logo": {
        "description": "Google Antigravity",
        "default": {
          "fontPath": "./media/antigravity.ttf",
          "fontCharacter": "\\e001"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "check:format": "biome format --write src",
    "check:biome": "biome lint src",
    "check:eslint": "eslint src --max-warnings 0",
    "check:lint": "run-s check:biome check:eslint",
    "check:tsc": "tsc --noEmit",
    "check:tsc:test": "tsc -p tsconfig.test.json --noEmit",
    "check:types": "run-s check:tsc check:tsc:test",
    "check:deps": "knip",
    "check:test": "vitest run test/unit",
    "check": "run-s check:format check:lint check:types check:deps check:test",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test": "vitest run",
    "package:vsix": "vsce package --allow-star-activation",
    "package": "run-s build package:vsix",
    "install:local": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.109.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.0.2",
    "eslint-config-biome": "^2.1.3",
    "eslint-plugin-boundaries": "^6.0.2",
    "knip": "^6.3.0",
    "npm-run-all2": "^8.0.4",
    "typescript": "^5.9.3",
    "vitest": "^3.0.8"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
